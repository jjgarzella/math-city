#!/usr/bin/env bash
# Recording stub for `bd`, used by the lifecycle transport tests (step 4b / 7 /
# 9). It NEVER touches a real Dolt store — it appends every invocation to
# $BD_LOG and returns the minimum canned output the formula's verbatim bash
# blocks consume, so those blocks can run end-to-end and be asserted against.
#
# Environment knobs (set by the test):
#   BD_LOG              file to append one line per invocation (required)
#   BD_ROOT             value returned as gc.root_bead_id for `bd show $GC_BEAD_ID --json`
#   BD_FINDINGS_EXISTS  "1" => `bd show <root>.findings` succeeds (container already there)
#   BD_STATE            dir holding the wisp-id counter (for deterministic ids)
set -u

log() { printf '%s\n' "$*" >> "$BD_LOG"; }
log "$@"

sub="${1:-}"

# arg value for `--flag=value` or `--flag value`; echoes value or empty.
flag_val() {
  local want="$1"; shift
  local prev="" a
  for a in "$@"; do
    case "$a" in
      "$want"=*) printf '%s' "${a#*=}"; return 0 ;;
    esac
    if [ "$prev" = "$want" ]; then printf '%s' "$a"; return 0; fi
    prev="$a"
  done
  return 0
}

has_flag() { for a in "$@"; do [ "$a" = "$1" ] && return 0; done; return 1; }

case "$sub" in
  show)
    target="${2:-}"
    if has_flag --json "$@"; then
      if [ "$target" = "${GC_BEAD_ID:-}" ]; then
        printf '[{"metadata":{"gc.root_bead_id":"%s"}}]\n' "${BD_ROOT:-}"
        exit 0
      fi
      case "$target" in
        *.findings)
          if [ "${BD_FINDINGS_EXISTS:-0}" = "1" ]; then
            printf '[{"id":"%s","status":"open"}]\n' "$target"; exit 0
          fi
          exit 1 ;;
        *) printf '[]\n'; exit 0 ;;
      esac
    fi
    # plain show: success/failure governs the "create container once" guard.
    case "$target" in
      *.findings) [ "${BD_FINDINGS_EXISTS:-0}" = "1" ] && exit 0 || exit 1 ;;
      *) exit 0 ;;
    esac
    ;;
  create)
    id="$(flag_val --id "$@")"
    if [ -n "$id" ]; then
      has_flag --silent "$@" && printf '%s\n' "$id"
      exit 0
    fi
    # ephemeral wisp: hand back a deterministic id from a counter.
    state="${BD_STATE:-$(dirname "$BD_LOG")}"
    mkdir -p "$state"
    n=$(( $(cat "$state/counter" 2>/dev/null || echo 0) + 1 ))
    printf '%s' "$n" > "$state/counter"
    printf 'wisp-%03d\n' "$n"
    exit 0
    ;;
  promote|update|close)
    exit 0 ;;
  mol)
    # `bd mol burn --force <wisp>`
    exit 0 ;;
  *)
    exit 0 ;;
esac
