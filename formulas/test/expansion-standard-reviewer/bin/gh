#!/usr/bin/env bash
# Test stub for `gh`, used by the PR-resolution branch so it can be exercised
# offline. PR view returns a fixed head/base snapshot; compare requests use those
# immutable OIDs (or a local git fixture when GH_API_FIXTURE=local). Any other
# gh call is a hard error so tests never silently depend on real GitHub.
set -u
if [ "${1:-}" = "pr" ] && [ "${2:-}" = "view" ]; then
  printf '{"headRefOid":"%s","baseRefOid":"%s","url":"%s"}\n' \
    "${GH_PR_HEAD_SHA:-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa}" \
    "${GH_PR_BASE_SHA:-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb}" \
    "${GH_PR_URL:-https://github.com/example/repo/pull/42}"
  exit 0
fi
if [ "${1:-}" = "api" ]; then
  endpoint=""
  for arg in "$@"; do
    case "$arg" in repos/*/compare/*) endpoint="$arg" ;; esac
  done
  compare="${endpoint##*/}"
  base="${compare%%...*}"
  head="${compare#*...}"
  [ -z "${GH_API_LOG:-}" ] || printf '%s\n' "$endpoint" >> "$GH_API_LOG"
  case "$compare" in
    *...*) ;;
    *) echo "gh stub: unsupported compare endpoint: $endpoint" >&2; exit 64 ;;
  esac
  if [ "${GH_API_FIXTURE:-}" = "local" ]; then
    case " $* " in
      *" --jq "*) git diff --name-only "$base...$head" ;;
      *) git diff "$base...$head" ;;
    esac
  else
    case " $* " in
      *" --jq "*) printf 'pkg/widget.go\n' ;;
      *) cat <<'DIFF'
diff --git a/pkg/widget.go b/pkg/widget.go
index 1111111..2222222 100644
--- a/pkg/widget.go
+++ b/pkg/widget.go
@@ -1,3 +1,4 @@
 package pkg
+func Added() int { return 1 }
DIFF
      ;;
    esac
  fi
  exit 0
fi
echo "gh stub: unsupported invocation: $*" >&2
exit 64
