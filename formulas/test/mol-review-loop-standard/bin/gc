#!/usr/bin/env bash
# Test stub for `gc`, used by the apply-fixes lib test (test_02). The apply-fixes
# transport calls `gc bd heartbeat` (a no-op success here). Record escalation's
# optional `gc session nudge` in $GC_NUDGE_LOG. Other calls are no-op successes.
set -u
if [ "${1:-}" = "session" ] && [ "${2:-}" = "nudge" ]; then
  shift 2
  [ -n "${GC_NUDGE_LOG:-}" ] && printf '%s\n' "$*" >> "$GC_NUDGE_LOG"
  exit "${GC_NUDGE_FAIL:-0}"
fi
exit 0
