# Step 0 yields a non-empty range; step 1 (the eligibility model) skips it as
# whitespace-only. The skip itself is a .6 (semantic) check, not deterministic.
EXPECTED_EMPTY=no
EXPECTED_KIND=range
EXPECTED_OUTCOME=skipped-trivial
NOTES="Step 1 should report 'skipped: <whitespace/formatting-only>'. No promotions."
