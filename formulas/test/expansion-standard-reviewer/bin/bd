#!/usr/bin/env bash
# Recording stub for `bd`, used by the analyze-lifecycle transport test. It NEVER
# touches a real Dolt store: it returns the minimum canned bead JSON the analyze
# block's verbatim bash consumes, and appends every `--set-metadata k=v` to
# $BD_META_LOG so the test can assert what the block recorded on the root.
#
# Environment knobs (set by the test):
#   BD_ROOT      gc.root_bead_id returned for `bd show $GC_BEAD_ID --json`
#   BD_WORKDIR   work_dir returned for `bd show $BD_ROOT --json` (the tree to review)
#   BD_META_LOG  file to append one `key=value` line per `--set-metadata` (required)
set -u

sub="${1:-}"

has_flag() { for a in "$@"; do [ "$a" = "$1" ] && return 0; done; return 1; }

case "$sub" in
  show)
    target="${2:-}"
    if has_flag --json "$@"; then
      if [ "$target" = "${GC_BEAD_ID:-}" ]; then
        printf '[{"id":"%s","metadata":{"gc.root_bead_id":"%s"}}]\n' "$target" "${BD_ROOT:-}"
      elif [ "$target" = "${BD_ROOT:-}" ]; then
        printf '[{"id":"%s","metadata":{"work_dir":"%s"}}]\n' "$target" "${BD_WORKDIR:-}"
      else
        printf '[]\n'
      fi
    fi
    exit 0 ;;
  update)
    # Record every --set-metadata key=value pair the block writes.
    shift
    prev=""
    for a in "$@"; do
      if [ "$prev" = "--set-metadata" ]; then
        printf '%s\n' "$a" >> "${BD_META_LOG:?BD_META_LOG must be set}"
      fi
      prev="$a"
    done
    exit 0 ;;
  heartbeat|close|create)
    exit 0 ;;
  *)
    exit 0 ;;
esac
