#!/usr/bin/env bash
# Recording stub for `bd`, used by the analyze-lifecycle (test_03) and the
# review-lane lib (test_05) transport tests. It NEVER touches a real Dolt store:
# it returns the minimum canned bead JSON the verbatim bash consumes, and records
# what the blocks wrote so the tests can assert it. It is a strict SUPERSET of the
# original analyze-only stub — the test_03 knobs are unchanged, and the test_05
# knobs only activate when their env vars are set.
#
# Environment knobs (set by the tests):
#   BD_ROOT          gc.root_bead_id returned for `bd show $GC_BEAD_ID --json`
#   BD_WORKDIR       work_dir returned for `bd show $BD_ROOT --json`
#   BD_META_LOG      file: one `key=value` line per `--set-metadata` (required by readers)
#   BD_REVIEW_INPUTS_DIR / BD_REVIEW_TARGET_KIND / BD_REVIEW_ELIGIBLE / BD_REVIEW_ELIGIBILITY_REASON
#                    when set, added to `bd show $BD_ROOT --json` metadata (the analyze
#                    pass's durable-input handles the review lenses read)
#   BD_CREATE_LOG    file: one tab-separated record per `bd create` (id/parent/labels/ephemeral/title/body1)
#   BD_UPDATE_LOG    file: one tab-separated record per `bd update` (id/status/notes)
set -u

sub="${1:-}"
state_dir="${BD_CREATE_LOG:-/nonexistent}.state"

# has_flag <flag> <args...> — true if <flag> appears among <args...>.
has_flag() { local want="$1"; shift; local a; for a in "$@"; do [ "$a" = "$want" ] && return 0; done; return 1; }
# arg_val <--key> <args...> — value of a `--key=value` argument (empty if absent).
arg_val() { local key="$1"; shift; local a; for a in "$@"; do case "$a" in "$key="*) printf '%s' "${a#*=}"; return 0 ;; esac; done; return 1; }

case "$sub" in
  show)
    target="${2:-}"
    if [ -f "$state_dir/$target.json" ]; then
      has_flag --json "$@" && jq -c '[.]' "$state_dir/$target.json"
      exit 0
    fi
    if [ -n "${BD_CANDIDATES_FILE:-}" ] && [ "$target" != "${BD_FINDINGS:-}" ]; then
      candidate="$(jq -c --arg id "$target" --arg parent "${BD_FINDINGS:-}" \
        '.[] | select(.id == $id) | . + {parent:$parent, ephemeral:(.ephemeral // true)}' "$BD_CANDIDATES_FILE")"
      if [ -n "$candidate" ]; then
        has_flag --json "$@" && printf '[%s]\n' "$candidate"
        exit 0
      fi
    fi
    if has_flag --json "$@"; then
      if [ "$target" = "${GC_BEAD_ID:-}" ]; then
        printf '[{"id":"%s","metadata":{"gc.root_bead_id":"%s"}}]\n' "$target" "${BD_ROOT:-}"
      elif [ "$target" = "${BD_ROOT:-}" ]; then
        # Root bead: work_dir, plus the analyze pass's durable-input handles when
        # the test populated them. Built with jq so optional fields stay valid JSON.
        jq -nc \
          --arg id "$target" \
          --arg work_dir "${BD_WORKDIR:-}" \
          --arg inputs_dir "${BD_REVIEW_INPUTS_DIR:-}" \
          --arg target_kind "${BD_REVIEW_TARGET_KIND:-}" \
          --arg eligible "${BD_REVIEW_ELIGIBLE:-}" \
          --arg reason "${BD_REVIEW_ELIGIBILITY_REASON:-}" \
          '{id:$id, metadata: ({"work_dir":$work_dir}
             + (if $inputs_dir  != "" then {"gc.review.inputs_dir":$inputs_dir} else {} end)
             + (if $target_kind != "" then {"gc.review.target_kind":$target_kind} else {} end)
             + (if $eligible    != "" then {"gc.review.eligible":$eligible} else {} end)
             + (if $reason      != "" then {"gc.review.eligibility_reason":$reason} else {} end))}
           | [.]'
      elif [ -n "${BD_FINDINGS:-}" ] && [ "$target" = "${BD_FINDINGS:-}" ] && [ -n "${BD_CANDIDATES_FILE:-}" ] && [ -f "${BD_CANDIDATES_FILE}" ]; then
        # Show omits .children in bd 1.3; dep list returns the fixture below.
        jq -nc --arg id "$target" '[{id:$id}]'
      else
        exit 1
      fi
      exit 0
    fi
    # No --json: an existence check (the findings-container guard uses this). The
    # known beads "exist"; the findings container exists only once populated.
    { [ "$target" = "${GC_BEAD_ID:-}" ] || [ "$target" = "${BD_ROOT:-}" ]; } && exit 0
    { [ -n "${BD_FINDINGS:-}" ] && [ "$target" = "${BD_FINDINGS:-}" ] && [ -n "${BD_CANDIDATES_FILE:-}" ]; } && exit 0
    exit 1 ;;
  dep)
    [ "${2:-}" = list ] && has_flag --json "$@" && has_flag --direction "$@" && has_flag --type "$@" || exit 2
    if [ "${3:-}" = "${BD_ROOT:-}" ]; then
      if [ -n "${BD_CANDIDATES_FILE:-}" ] || [ -f "$state_dir/${BD_ROOT}.findings.json" ]; then
        jq -nc --arg id "${BD_ROOT}.findings" '[{id:$id}]'
      else
        printf '[]\n'
      fi
    elif [ "${3:-}" = "${BD_FINDINGS:-}" ]; then
      jq 'map(. + {ephemeral:(.ephemeral // true)})' "$BD_CANDIDATES_FILE"
    else
      exit 2
    fi
    exit 0 ;;
  create)
    shift
    if [ -n "${BD_CREATE_LOG:-}" ]; then
      id="$(arg_val --id "$@" || true)"
      parent="$(arg_val --parent "$@" || true)"
      labels="$(arg_val --labels "$@" || true)"
      priority="$(arg_val --priority "$@" || true)"
      title="$(arg_val --title "$@" || true)"
      bodyfile="$(arg_val --body-file "$@" || true)"
      ephemeral=no; has_flag --ephemeral "$@" && ephemeral=yes
      body1=""
      [ -n "$bodyfile" ] && [ -f "$bodyfile" ] && body1="$(head -n1 "$bodyfile")"
      printf 'id=%s\tparent=%s\tlabels=%s\tephemeral=%s\ttitle=%s\tbody1=%s\n' \
        "$id" "$parent" "$labels" "$ephemeral" "$title" "$body1" >> "$BD_CREATE_LOG"
    fi
    # Match bd 1.3: explicit ids and --parent cannot be combined.
    [ -n "$(arg_val --id "$@" || true)" ] && [ -n "$(arg_val --parent "$@" || true)" ] && exit 2
    # Echo the bead id the caller captures: the explicit --id, else a stub wisp id.
    id="$(arg_val --id "$@" || true)"
    [ -z "$id" ] && id="wisp-stub-$$"
    if [ -n "${BD_CREATE_LOG:-}" ]; then
      mkdir -p "$state_dir"
      [ -n "$bodyfile" ] || bodyfile=/dev/null
      jq -nc --arg id "$id" --arg parent "$parent" --arg label "$labels" \
        --rawfile body "$bodyfile" --arg title "$title" --argjson priority "${priority:-2}" --argjson eph "$([ "$ephemeral" = yes ] && echo true || echo false)" \
        '{id:$id,parent:$parent,labels:([$label]|map(select(.!=""))),description:$body,title:$title,ephemeral:$eph,priority:$priority}' > "$state_dir/$id.json"
    fi
    printf '%s\n' "$id"
    exit 0 ;;
  update)
    shift
    bid="${1:-}"
    parent="$(arg_val --parent "$@" || true)"
    if [ -f "$state_dir/$bid.json" ] && [ -n "$parent" ]; then
      jq --arg parent "$parent" '.parent=$parent' "$state_dir/$bid.json" > "$state_dir/update.json"
      mv "$state_dir/update.json" "$state_dir/$bid.json"
    fi
    priority="$(arg_val --priority "$@" || true)"
    if [ -n "${BD_CANDIDATES_FILE:-}" ] && [ -n "$priority" ]; then
      jq --arg id "$bid" --argjson p "$priority" 'map(if .id==$id then .priority=$p else . end)' "$BD_CANDIDATES_FILE" > "$BD_CANDIDATES_FILE.tmp"
      mv "$BD_CANDIDATES_FILE.tmp" "$BD_CANDIDATES_FILE"
    fi
    prev=""; status=""; notes=""
    for a in "$@"; do
      if [ "$prev" = "--set-metadata" ]; then
        printf '%s\n' "$a" >> "${BD_META_LOG:?BD_META_LOG must be set}"
      elif [ "$prev" = "--notes" ]; then
        notes="$a"
      fi
      case "$a" in
        --status=*)   status="${a#*=}" ;;
        --notes=*)    notes="${a#*=}" ;;
        --priority=*) priority="${a#*=}" ;;
      esac
      prev="$a"
    done
    if [ -n "${BD_UPDATE_LOG:-}" ]; then
      printf 'id=%s\tstatus=%s\tpriority=%s\tnotes=%s\n' "$bid" "$status" "${priority:-}" "$notes parent=$parent" >> "$BD_UPDATE_LOG"
    fi
    exit 0 ;;
  promote)
    # `bd promote <wisp> --reason=<r>` — record the survivor promotion so the
    # synthesis-lib test (test_06) can assert which candidates became durable.
    shift
    wisp="${1:-}"
    reason="$(arg_val --reason "$@" || true)"
    jq --arg id "$wisp" 'map(if .id==$id then .ephemeral=false else . end)' "$BD_CANDIDATES_FILE" > "$BD_CANDIDATES_FILE.tmp"
    mv "$BD_CANDIDATES_FILE.tmp" "$BD_CANDIDATES_FILE"
    [ -n "${BD_PROMOTE_LOG:-}" ] && printf 'promote\tid=%s\treason=%s\n' "$wisp" "$reason" >> "$BD_PROMOTE_LOG"
    exit 0 ;;
  label)
    # Installed syntax: issue IDs first, label last.
    [ "${2:-}" = add ] && [ "$#" -eq 4 ] || exit 2
    id="$3"; lbl="$4"
    [ -n "${BD_PROMOTE_LOG:-}" ] && printf 'label\t%s\t%s\n' "$lbl" "$id" >> "$BD_PROMOTE_LOG"
    jq --arg id "$id" --arg label "$lbl" \
      'map(if .id==$id then .labels=((.labels // []) + [$label] | unique) else . end)' \
      "$BD_CANDIDATES_FILE" > "$BD_CANDIDATES_FILE.tmp"
    mv "$BD_CANDIDATES_FILE.tmp" "$BD_CANDIDATES_FILE"
    exit 0 ;;
  mol)
    # `bd mol burn --force <wisp>` — record the burn of a duplicate/sub-threshold.
    if [ "${2:-}" = "burn" ] && [ -n "${BD_PROMOTE_LOG:-}" ]; then
      shift 2
      for a in "$@"; do case "$a" in --*) ;; *) printf 'burn\t%s\n' "$a" >> "$BD_PROMOTE_LOG" ;; esac; done
    fi
    exit 0 ;;
  heartbeat|close)
    exit 0 ;;
  *)
    exit 0 ;;
esac
