#!/usr/bin/env bash
# Recording/canned stub for `bd`, used by the apply-fixes lib test (test_02). It
# NEVER touches a real Dolt store — it returns the minimum canned bead JSON the
# shared apply-fixes transport (formulas/lib/review-apply-fixes.sh) consumes, and
# records every metadata/status write so the assertions can check what apply-fixes
# wrote. Modeled on the synthesis suite's stub (expansion-standard-reviewer/bin/bd).
#
# Env knobs (set by the test via afx_env):
#   GC_BEAD_ID         the apply-fixes bead id the lib resolves
#   BD_ROOT            gc.root_bead_id returned for `bd show $GC_BEAD_ID` + the root id
#   BD_SYNTH_VERDICT   gc.review.synthesis_verdict on the root (absent if empty)
#   BD_SYNTH_PROMOTED  gc.review.synthesis_promoted on the root (absent if empty)
#   BD_SYNTH_BURNED    gc.review.synthesis_burned on the root (absent if empty)
#   BD_WORKDIR         work_dir on the root (absent if empty)
#   BD_FINDINGS        the findings container id (<root>.findings)
#   BD_FINDINGS_FILE   file holding the container's .children JSON (durable findings)
#   BD_META_LOG        file: one `<bead>\t<key=value>` line per `--set-metadata`
#   BD_UPDATE_LOG      file: one `id=.. status=.. notes=..` line per `bd update`
set -u

has_flag() { local want="$1"; shift; local a; for a in "$@"; do [ "$a" = "$want" ] && return 0; done; return 1; }

sub="${1:-}"
case "$sub" in
  show)
    target="${2:-}"
    if has_flag --json "$@"; then
      if [ "$target" = "${GC_BEAD_ID:-}" ]; then
        printf '[{"id":"%s","metadata":{"gc.root_bead_id":"%s"}}]\n' "$target" "${BD_ROOT:-}"
      elif [ "$target" = "${BD_ROOT:-}" ]; then
        # Root bead: the synthesis verdict + counts + work_dir, built with jq so
        # optional fields stay valid JSON when a knob is unset.
        jq -nc \
          --arg id "$target" \
          --arg v  "${BD_SYNTH_VERDICT:-}" \
          --arg p  "${BD_SYNTH_PROMOTED:-}" \
          --arg b  "${BD_SYNTH_BURNED:-}" \
          --arg wd "${BD_WORKDIR:-}" \
          '{id:$id, metadata: (
               (if $v  != "" then {"gc.review.synthesis_verdict":$v}   else {} end)
             + (if $p  != "" then {"gc.review.synthesis_promoted":$p}  else {} end)
             + (if $b  != "" then {"gc.review.synthesis_burned":$b}    else {} end)
             + (if $wd != "" then {"work_dir":$wd}                     else {} end))}
           | [.]'
      elif [ -n "${BD_FINDINGS:-}" ] && [ "$target" = "${BD_FINDINGS:-}" ] && [ -n "${BD_FINDINGS_FILE:-}" ] && [ -f "${BD_FINDINGS_FILE}" ]; then
        # Findings container: return the durable findings as its .children (the
        # apply-fixes lib enumerates them). The test writes the children JSON.
        jq -c '[{id: $id, children: .}]' --arg id "$target" "$BD_FINDINGS_FILE"
      else
        printf '[]\n'
      fi
      exit 0
    fi
    # No --json: an existence check (the findings-container guard uses this).
    { [ "$target" = "${GC_BEAD_ID:-}" ] || [ "$target" = "${BD_ROOT:-}" ]; } && exit 0
    { [ -n "${BD_FINDINGS:-}" ] && [ "$target" = "${BD_FINDINGS:-}" ] && [ -n "${BD_FINDINGS_FILE:-}" ] && [ -f "${BD_FINDINGS_FILE}" ]; } && exit 0
    exit 1 ;;
  update)
    shift
    bid="${1:-}"
    prev=""; status=""; notes=""
    for a in "$@"; do
      if [ "$prev" = "--set-metadata" ] && [ -n "${BD_META_LOG:-}" ]; then
        printf '%s\t%s\n' "$bid" "$a" >> "$BD_META_LOG"
      fi
      case "$a" in
        --status=*) status="${a#*=}" ;;
        --notes=*)  notes="${a#*=}" ;;
      esac
      prev="$a"
    done
    [ -n "${BD_UPDATE_LOG:-}" ] && printf 'id=%s\tstatus=%s\tnotes=%s\n' "$bid" "$status" "$notes" >> "$BD_UPDATE_LOG"
    exit 0 ;;
  heartbeat|close)
    exit 0 ;;
  *)
    exit 0 ;;
esac
